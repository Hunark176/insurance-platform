  "components" : {
    "schemas" : {
      "AuditEntryResponse" : {
        "type" : "object",
        "properties" : {
          "action" : {
            "type" : "string"
          },
          "actor" : {
            "type" : "string"
          },
          "entityId" : {
            "type" : "string"
          },
          "entityType" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "occurredAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "requestId" : {
            "type" : "string"
          },
          "summary" : {
            "type" : "string"
          }
        }
      },
      "ClaimPageResponse" : {
        "type" : "object",
        "description" : "Eine paginierte Übersicht von Schadenfällen",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ClaimResponse"
            }
          },
          "first" : {
            "type" : "boolean"
          },
          "last" : {
            "type" : "boolean"
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "ClaimResponse" : {
        "type" : "object",
        "description" : "Antwortdaten eines Schadenfalls",
        "properties" : {
          "amount" : {
            "type" : "number",
            "description" : "Geschätzter Schadenbetrag in Euro",
            "example" : 500.0
          },
          "claimType" : {
            "type" : "string",
            "description" : "Typ des Schadenfalls",
            "example" : "AUTO"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Zeitpunkt der Erstellung",
            "example" : "2026-09-24T17:00:00Z"
          },
          "customerName" : {
            "type" : "string",
            "description" : "Anzeigename des Kunden",
            "example" : "Max Mustermann"
          },
          "customerNumber" : {
            "type" : "string",
            "description" : "Kundennummer",
            "example" : "K12345"
          },
          "description" : {
            "type" : [ "string", "null" ],
            "description" : "Detaillierte Schadensbeschreibung",
            "example" : "Kratzer an der linken Fahrzeugtür"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Eindeutige ID des Claims",
            "example" : 1
          },
          "occurredOn" : {
            "type" : "string",
            "format" : "date",
            "description" : "Datum des Schadenereignisses",
            "example" : "2026-09-20"
          },
          "policyId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string",
            "description" : "Aktueller Bearbeitungsstatus",
            "enum" : [ "RECEIVED", "IN_REVIEW", "APPROVED", "REJECTED" ],
            "example" : "RECEIVED"
          }
        }
      },
      "CreateClaimRequest" : {
        "type" : "object",
        "description" : "Claim-Daten zum Erstellen",
        "properties" : {
