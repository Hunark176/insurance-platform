          "description" : "Neuer Status",
          "example" : "IN_REVIEW",
          "in" : "query",
          "name" : "newStatus",
          "required" : true,
          "schema" : {
            "type" : "string",
            "description" : "Status eines Claims",
            "enum" : [ "RECEIVED", "IN_REVIEW", "APPROVED", "REJECTED" ],
            "example" : "RECEIVED"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description" : "Status erfolgreich aktualisiert"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description" : "Anmeldung erforderlich"
          },
          "403" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description" : "Rolle CLERK oder ADMIN erforderlich"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description" : "Claim nicht gefunden"
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ],
        "summary" : "Status eines Claims aktualisieren (CLERK, ADMIN)",
        "tags" : [ "Claims" ]
      }
    },
