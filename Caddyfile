{$DOMAIN} {
    encode gzip zstd

    @staticAssets path_regexp staticAssets \.(?i:js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico|webp)$
    header @staticAssets Cache-Control "public, max-age=31536000, immutable"

    @index path / /index.html
    header @index Cache-Control "no-cache, no-store, must-revalidate"

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
